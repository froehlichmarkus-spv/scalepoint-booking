#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Busy times only"
msgstr "Nur belegte Zeiten"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Don't block"
msgstr "Nicht blockieren"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Exchange reports busy times for your main calendar only."
msgstr "Exchange meldet belegte Zeiten nur für deinen Hauptkalender."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Exchange reports busy times for your whole mailbox from your main calendar, so this choice works whether or not the calendar is shown."
msgstr "Exchange meldet die belegten Zeiten deines gesamten Postfachs über deinen Hauptkalender. Diese Einstellung wirkt daher unabhängig davon, ob der Kalender angezeigt wird."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Off"
msgstr "Aus"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "On"
msgstr "Ein"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Read-only"
msgstr "Schreibgeschützt"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Show and block"
msgstr "Anzeigen und blockieren"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Show only"
msgstr "Nur anzeigen"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "This calendar stays read-only: bookings are never written to it. Choose another calendar as your booking destination."
msgstr "Dieser Kalender bleibt schreibgeschützt: Buchungen werden nie in ihn eingetragen. Wähle einen anderen Kalender als Ziel für deine Buchungen."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/caldav_reconnect_modal.ex
#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Your booking calendar always blocks your availability."
msgstr "Dein Buchungskalender blockiert immer deine Verfügbarkeit."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "%{used} of %{count} calendar in use, %{blocking} blocking your availability"
msgid_plural "%{used} of %{count} calendars in use, %{blocking} blocking your availability"
msgstr[0] "%{used} von %{count} Kalender in Verwendung, davon blockieren deine Verfügbarkeit: %{blocking}"
msgstr[1] "%{used} von %{count} Kalendern in Verwendung, davon blockieren deine Verfügbarkeit: %{blocking}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Busy times block"
msgstr "Blockiert belegte Zeiten"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Busy times of %{calendar}"
msgstr "Belegte Zeiten von %{calendar}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Exchange reports busy times for your whole mailbox, and they block your booking page. Refresh this connection to list your main calendar and choose there whether they do."
msgstr "Exchange meldet die belegten Zeiten deines gesamten Postfachs, und diese blockieren deine Buchungsseite. Aktualisiere diese Verbindung, damit dein Hauptkalender in der Liste erscheint, und lege dort fest, ob sie blockieren."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Show %{calendar} on your calendar"
msgstr "%{calendar} in deinem Kalender anzeigen"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "This folder's events are shown only; busy times come from your whole mailbox."
msgstr "Die Ereignisse dieses Ordners werden nur angezeigt; die belegten Zeiten stammen aus deinem gesamten Postfach."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Use of %{calendar}"
msgstr "Verwendung von %{calendar}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Whole mailbox"
msgstr "Gesamtes Postfach"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "Count every event as busy"
msgstr "Jeden Termin als belegt werten"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "Holiday and school-holiday calendars mark their events as free, so they would block nothing. With this on, every event in the feed blocks the time, however it is marked."
msgstr ""
"Feiertags- und Ferienkalender markieren ihre Einträge als frei, dadurch würden sie nichts blockieren. Ist dies aktiv, blockiert jeder Eintrag im Feed die Zeit, egal wie er markiert ist."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/shared_form_components.ex
#, elixir-autogen, elixir-format
msgid "If you revoked the old app-specific password or changed your Apple ID password since connecting, the old one will not work again: generate a new one and enter it here."
msgstr "Falls du das alte App-spezifische Passwort seit dem Verbinden widerrufen oder dein Apple-ID-Passwort geändert haben, funktioniert das alte nicht mehr: Erstellst du ein neues und gib es hier ein."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/shared_form_components.ex
#, elixir-autogen, elixir-format
msgid "Enter your Apple ID email and that password below."
msgstr "Gib unten die E-Mail-Adresse deiner Apple-ID und dieses Passwort ein."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/shared_form_components.ex
#, elixir-autogen, elixir-format
msgid "Open your Apple Account"
msgstr "Öffne deinen Apple Account"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/shared_form_components.ex
#, elixir-autogen, elixir-format
msgid "Under Sign-In and Security, choose App-Specific Passwords and create one."
msgstr "Wähle unter „Anmelden und Sicherheit“ die Option „App-spezifische Passwörter“ und erstelle ein neues Passwort."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/shared_form_components.ex
#, elixir-autogen, elixir-format
msgid "iCloud needs an app-specific password, not your Apple ID password."
msgstr "iCloud benötigt ein App-spezifisches Passwort, nicht das Passwort deiner Apple-ID."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose which calendars the scheduler uses, and which of them block times on your booking page."
msgstr "Wähle, welche Kalender the scheduler verwendet und welche davon Zeiten auf deiner Buchungsseite blockieren."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "How this calendar's events are shown in your the scheduler calendar."
msgstr "So werden die Ereignisse dieses Kalenders in deinem the scheduler-Kalender angezeigt."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/shared_form_components.ex
#, elixir-autogen, elixir-format
msgid "Keep this password for as long as you use this booking page. Revoking it, or changing your Apple ID password, disconnects iCloud, and your booking page offers no times until you reconnect."
msgstr "Behalte dieses Passwort, solange du the scheduler nutzen. Wenn du es widerrufen oder dein Apple-ID-Passwort ändern, wird iCloud getrennt, und deine Buchungsseite bietet keine Zeiten an, bis du iCloud erneut verbinden."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Shared with you as busy times only. the scheduler can block these times but cannot show the events."
msgstr "Nur mit belegten Zeiten für dich freigegeben. the scheduler kann diese Zeiten blockieren, die Ereignisse aber nicht anzeigen."
