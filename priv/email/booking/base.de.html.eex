<!doctype html>
<html lang="de" dir="ltr" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark">
<meta name="x-apple-disable-message-reformatting"><meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
<title><%= assigns["subject"] %></title>
<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:AllowPNG/><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
<style>body,table,td,p,a,h1,span,b{font-family:'Segoe UI',Arial,sans-serif!important}</style><![endif]-->
<!-- Growth OS mail base v3 (DS v2.8). Source: design-system/email/base.html. Do not edit per module: fill the {{…}} slots. -->
<style>
:root{color-scheme:light dark;supported-color-schemes:light dark}
body{margin:0!important;padding:0!important;width:100%!important;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
table{border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0} img{border:0;outline:none;-ms-interpolation-mode:bicubic}
a{color:#0B6E66} a[x-apple-data-detectors]{color:inherit!important;text-decoration:underline!important}
u + #body a{color:inherit;text-decoration:underline}
@media (max-width:620px){
 .wrap{padding:0!important} .card{border-radius:0!important;border-left:0!important;border-right:0!important}
 .hdr,.hdr img{border-radius:0!important} .pad{padding:28px 20px 8px!important} .ft{padding:22px 20px 32px!important}
 .h1{font-size:24px!important;line-height:30px!important} .btnt{width:100%!important} .btn{display:block!important;text-align:center!important}
 .pcp{padding:14px 14px!important} .pcr{padding-left:14px!important;padding-right:14px!important} .hide-sm{display:none!important}
 .st{padding-left:12px!important;padding-right:8px!important} .stv{font-size:20px!important} .dvr{padding:0 20px!important}
}
@media (prefers-color-scheme:dark){
 .bg{background:#0B1220!important} .card{background:#131D2F!important;border-color:#2A3448!important}
 .tx{color:#E6EBF2!important} .t2{color:#C3CDDA!important} .mu{color:#A7B2C2!important} .ft,.ft td{color:#A7B2C2!important}
 .eb{color:#FFD98A!important} .lk{color:#5EE6D8!important} .btn{background:#F4F7FB!important;color:#0D1828!important;border-color:#F4F7FB!important}
 .pc{background:#0F1828!important;border-color:#2A3448!important} .ln{border-color:#2A3448!important;background:#2A3448!important}
 .ib{background:#17233A!important;border-top-color:#2A3448!important;border-right-color:#2A3448!important;border-bottom-color:#2A3448!important}
 .av{background:#1C2B40!important;color:#FFD98A!important}
 .chip-success{background:#12352A!important;color:#6EE7A8!important} .chip-warning{background:#3A2C10!important;color:#FFD27A!important}
 .chip-danger{background:#3B1A1A!important;color:#FF9C92!important} .chip-module{background:#1C2B40!important;color:#FFD98A!important}
 .chip-neutral{background:#1C2B40!important;color:#C3CDDA!important} .mt-on{background:#FFC24A!important} .mt-off{background:#2A3448!important}
 .hdr{background:#0E1A2C!important} .hdr-l{display:none!important;max-height:0!important} .hdr-d{display:block!important;max-height:none!important}
}
[data-ogsc] .tx{color:#E6EBF2!important} [data-ogsc] .t2{color:#C3CDDA!important} [data-ogsc] .mu,[data-ogsc] .ft{color:#A7B2C2!important}
[data-ogsc] .lk{color:#5EE6D8!important} [data-ogsc] .eb{color:#FFD98A!important}
[data-ogsb] .bg{background:#0B1220!important} [data-ogsb] .card{background:#131D2F!important} [data-ogsb] .pc{background:#0F1828!important}
[data-ogsb] .btn{background:#F4F7FB!important} [data-ogsc] .btn{color:#0D1828!important}
</style>
</head>
<body id="body" class="bg" style="margin:0;padding:0;background:#F4F7FB;word-spacing:normal">
<div role="article" aria-roledescription="email" aria-label="<%= assigns["subject"] %>" lang="de" style="background:#F4F7FB" class="bg">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all"><%= assigns["preheader"] %>&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>
<table role="presentation" class="bg" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#F4F7FB" style="background:#F4F7FB"><tr><td class="wrap" align="center" style="padding:32px 12px 8px">
<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
<table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF" style="max-width:600px;background:#FFFFFF;border:1px solid #DCE3EC;border-radius:16px;border-collapse:separate;mso-border-alt:none">
<tr><td class="hdr" bgcolor="#FFF3D6" style="padding:0;border-radius:15px 15px 0 0;background:#FFF3D6;font-family:Geist,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;line-height:24px;font-weight:600;color:#111E32"><img class="hdr-l" src="cid:header-booking-light@booking.scalepoint" width="600" height="144" alt="ScalePoint Growth OS BookDesk24" style="display:block;width:100%;max-width:600px;height:auto;border:0;border-radius:15px 15px 0 0;font-family:Geist,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;line-height:24px;font-weight:600;color:#111E32"><!--[if !mso]><!--><img class="hdr-d" src="cid:header-booking-dark@booking.scalepoint" width="600" height="144" alt="ScalePoint Growth OS BookDesk24" style="display:none;max-height:0;width:100%;max-width:600px;height:auto;border:0;border-radius:15px 15px 0 0;mso-hide:all"><!--<![endif]--></td></tr>
<tr><td class="pad" style="padding:34px 40px 8px">
<p class="eb" style="margin:0 0 12px;font-family:Geist,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:16px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#835000"><span style="color:#F2A40E;font-size:14px;letter-spacing:0">&#9679;</span>&nbsp; <%= assigns["eyebrow"] %></p>
<h1 class="tx h1" style="margin:0 0 14px;font-family:Geist,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:27px;line-height:34px;font-weight:650;letter-spacing:-.02em;color:#111E32"><%= assigns["title"] %></h1>
<div class="t2" style="margin:0 0 4px;font-family:Geist,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:26px;font-weight:400;color:#3C4656"><%= assigns["body"] %></div>
<%= if assigns["card"] do %><div style="margin:18px 0 8px"><%= assigns["card"] %></div><% end %>
<%= if assigns["cta"] do %><table role="presentation" class="btnt" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 18px"><tr><td align="center" bgcolor="#111E32" style="border-radius:10px">
<!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="<%= assigns["cta_url"] %>" style="height:48px;v-text-anchor:middle;width:<%= assigns["cta_vml_width"] %>px" arcsize="21%" stroke="f" fillcolor="#111E32"><w:anchorlock/><center style="color:#FFFFFF;font-family:'Segoe UI',Arial,sans-serif;font-size:16px;font-weight:bold"><%= assigns["cta_label"] %>&nbsp;&rarr;</center></v:roundrect><![endif]-->
<!--[if !mso]><!--><a class="btn" href="<%= assigns["cta_url"] %>" style="display:inline-block;background:#111E32;color:#FFFFFF;border:1px solid #111E32;font-family:Geist,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:48px;font-weight:600;text-decoration:none;padding:0 28px;border-radius:10px;mso-hide:all"><%= assigns["cta_label"] %>&nbsp;&rarr;</a><!--<![endif]--></td></tr></table>
<p class="mu" style="margin:0 0 20px;font-family:Geist,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;font-weight:400;color:#4A5566">Button funktioniert nicht? Kopier diesen Link in deinen Browser:<br><a class="lk" href="<%= assigns["cta_url"] %>" style="color:#0B6E66;text-decoration:underline;word-break:break-all"><%= assigns["cta_url"] %></a></p><% end %>
<%= if assigns["info"] do %><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 26px;border-collapse:separate"><tr><td class="ib" bgcolor="#F4F7FB" style="background:#F4F7FB;border:1px solid #DCE3EC;border-left:4px solid #F2A40E;border-radius:12px;padding:14px 18px;font-family:Geist,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;font-weight:400;color:#3C4656"><b class="tx" style="color:#111E32;font-weight:600"><%= assigns["info_title"] %></b><br><span class="t2" style="color:#3C4656"><%= assigns["info_body"] %></span></td></tr></table><% end %>
</td></tr>
<tr><td style="padding:0 40px" class="dvr"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="ln" height="1" bgcolor="#DCE3EC" style="height:1px;line-height:1px;font-size:1px;background:#DCE3EC">&nbsp;</td></tr></table></td></tr>
<tr><td class="pad" style="padding:18px 40px 30px;font-family:Geist,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;font-weight:400;color:#3C4656"><span class="t2" style="color:#3C4656">Fragen? Antworte einfach auf diese Mail oder schreib an <a class="lk" href="mailto:support@scalepoint-ventures.com" style="color:#0B6E66;text-decoration:underline">support@scalepoint-ventures.com</a>.</span></td></tr>
</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
<tr><td class="wrap" align="center" style="padding:0 12px">
<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px"><tr><td class="ft" style="padding:22px 40px 40px;font-family:Geist,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;font-weight:400;color:#4A5566">
<p style="margin:0 0 10px"><%= assigns["footer_reason"] %></p>
<%= if assigns["powered_by"] do %><p style="margin:0 0 10px">Powered by BookDesk24</p><% end %>
<p style="margin:0 0 10px">ScalePoint Ventures Oy · Almavägen 26, 65610 Mustasaari, Finnland · Y-Tunnus 3620767-9</p>
<p style="margin:0"><a class="lk" href="<%= assigns["privacy_url"] %>" style="color:#0B6E66;text-decoration:underline">Datenschutz</a> &nbsp;·&nbsp; <a class="lk" href="<%= assigns["notice_url"] %>" style="color:#0B6E66;text-decoration:underline">Impressum</a><%= if assigns["unsub"] do %> &nbsp;·&nbsp; <a class="lk" href="<%= assigns["unsub_url"] %>" style="color:#0B6E66;text-decoration:underline">Abmelden</a><% end %></p>
</td></tr></table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr></table>
</div>
</body>
</html>
