# Copy to deploy/.env on the server. Do not commit that copy.
# Generate secrets on the server. None of the values below are real.

SPV_BOOKING_IMAGE=replace-with-registry-tag
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-24
SECRET_KEY_BASE=replace-with-openssl-rand-base64-64
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-48
SPV_OWNER_PASSWORD=replace-with-a-long-password

SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false

SPV_SENDER_EMAIL=booking@scalepoint-ventures.com
SPV_SENDER_NAME=ScalePoint Ventures
NEUTRAL_SENDER_EMAIL=booking@bookdesk24.com
NEUTRAL_SENDER_NAME=BookDesk24

# Public repository. Set empty to hide the link.
SOURCE_OFFER_URL=https://github.com/froehlichmarkus-spv/scalepoint-booking

# growth-os-billing. Leave empty until that service is deployed.
# STRIPE_SECRET_KEY does not belong in this app.
PLANS_ENABLED=true
GROWTH_OS_BILLING_URL=
GROWTH_OS_BILLING_API_KEY=
GROWTH_OS_BILLING_WEBHOOK_SECRET=
