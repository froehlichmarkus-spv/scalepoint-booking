<!DOCTYPE html>
<html lang={Gettext.get_locale(TymeslotWeb.Gettext)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{dgettext("errors", "Something went wrong")} · {product_name()}</title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/brand/favicon.svg"} />
    <link rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <body>
    <main class="relative flex min-h-screen items-center justify-center overflow-hidden bg-linear-to-br from-turquoise-100 via-cyan-50 to-turquoise-200 p-4">
      <div class="relative z-10 w-full max-w-md rounded-token-3xl border border-white/60 bg-white/95 p-8 text-center shadow-glass-xl backdrop-blur-md sm:p-10">
        <a href={~p"/"} class="mb-8 inline-block" aria-label={product_name()}>
          <.logo img_class="h-12" />
        </a>
        <p class="mt-6 text-token-sm font-bold uppercase tracking-[0.2em] text-turquoise-600">
          {dgettext("errors", "Error 500")}
        </p>
        <h1 class="mt-2 text-token-3xl font-black tracking-tight text-tymeslot-900">
          {dgettext("errors", "Something went wrong")}
        </h1>
        <p class="mt-3 text-token-base text-tymeslot-500">
          {dgettext(
            "errors",
            "Please try again in a moment. If it keeps happening, write to %{email}.",
            email: support_email()
          )}
        </p>
        <a
          href={~p"/"}
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-token-2xl bg-linear-to-br from-turquoise-600 to-cyan-600 px-7 py-3.5 text-token-base font-bold text-white"
        >
          {home_label()}
        </a>
      </div>
    </main>
  </body>
</html>
